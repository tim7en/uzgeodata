{
  "name": "uzgeodata-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server.mjs",
    "preview": "npm run start",
    "ontology:profile": "python PIPELINES/ontology/profile_external_source.py",
    "ontology:details": "python PIPELINES/ontology/extract_external_details.py",
    "ontology:build": "python PIPELINES/ontology/build_ontology.py",
    "ontology:validate": "python PIPELINES/ontology/validate_ontology.py",
    "ontology:propose": "python PIPELINES/ontology/propose_assertions.py",
    "ontology:review": "python PIPELINES/ontology/review_assertions.py",
    "hydrography:build": "powershell -NoProfile -ExecutionPolicy Bypass -File PIPELINES/run_hydrography_build.ps1",
    "test:ontology": "python -m pytest TESTS/test_ontology.py -q",
    "test:trace": "node --test TESTS/test_basin_trace.mjs",
    "hydrography:basinatlas": "python PIPELINES/extract_uz_basinatlas.py",
    "ontology:hydroatlas": "python PIPELINES/ontology/build_hydroatlas_vocabulary.py",
    "hydrography:atlaslinks": "python PIPELINES/build_atlas_basin_links.py",
    "hydrography:zonalstats": "python PIPELINES/build_basin_zonal_stats.py",
    "hydrography:attributes": "python PIPELINES/build_basin_attributes.py"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "latest",
    "dotenv": "latest",
    "express": "latest",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "multer": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "^5.0.0",
    "typescript": "latest",
    "vite": "^5.4.21"
  }
}
