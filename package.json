{
  "name": "uzgeodata-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node server.mjs",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server.mjs",
    "preview": "npm run start",
    "ontology:profile": "python PIPELINES/ontology/profile_external_source.py",
    "ontology:details": "python PIPELINES/ontology/extract_external_details.py",
    "ontology:build": "python PIPELINES/ontology/build_ontology.py",
    "ontology:earth-engine": "python PIPELINES/project_earth_engine_sources.py",
    "ontology:semantics": "python PIPELINES/project_semantic_rules.py",
    "ontology:validate": "python PIPELINES/ontology/validate_ontology.py",
    "ontology:propose": "python PIPELINES/ontology/propose_assertions.py",
    "ontology:review": "python PIPELINES/ontology/review_assertions.py",
    "hydrography:build": "powershell -NoProfile -ExecutionPolicy Bypass -File PIPELINES/run_hydrography_build.ps1",
    "test:ontology": "python -m pytest TESTS/test_ontology.py -q",
    "test:trace": "node --test TESTS/test_basin_trace.mjs",
    "test:landcover": "node --test TESTS/test_landcover_model.mjs",
    "test:climate": "node --test TESTS/test_basin_layers_model.mjs",
    "test:ontology-ui": "node --test TESTS/test_ontology_network_model.mjs TESTS/test_ontology_export_model.mjs",
    "test:raster": "python -m pytest TESTS/test_raster_to_geojson.py -q",
    "test": "python -m pytest TESTS -q && node --test TESTS/test_basin_trace.mjs TESTS/test_landcover_model.mjs TESTS/test_basin_layers_model.mjs TESTS/test_landing_model.mjs TESTS/test_ontology_network_model.mjs TESTS/test_ontology_export_model.mjs && npm run build",
    "hydrography:basinatlas": "python PIPELINES/extract_uz_basinatlas.py",
    "ontology:hydroatlas": "python PIPELINES/ontology/build_hydroatlas_vocabulary.py",
    "hydrography:atlaslinks": "python PIPELINES/build_atlas_basin_links.py",
    "hydrography:zonalstats": "python PIPELINES/build_basin_zonal_stats.py",
    "hydrography:attributes": "python PIPELINES/build_basin_attributes.py",
    "hydrography:adminlinks": "python PIPELINES/build_admin_basin_links.py",
    "hydrography:align-basins": "python PIPELINES/align_hydrography_basins.py",
    "headwaters:basins": "python PIPELINES/build_headwater_pilot.py",
    "basins:transboundary": "python PIPELINES/build_transboundary_basins.py",
    "headwaters:elevation": "python PIPELINES/build_headwater_elevation_bands.py",
    "headwaters:era5": "python PIPELINES/update_headwater_era5.py",
    "basins:era5": "python PIPELINES/update_headwater_era5.py --scope full-basin",
    "headwaters:era5:elevation": "python PIPELINES/update_headwater_era5_elevation.py",
    "headwaters:anomaly": "python PIPELINES/era5_headwater_anomaly_service.py",
    "basins:anomaly": "python PIPELINES/era5_headwater_anomaly_service.py --scope full-basin",
    "headwaters:snow": "python PIPELINES/modis_snow_headwater_service.py",
    "headwaters:glaciers": "python PIPELINES/build_glacier_inventory.py",
    "basins:roles": "python PIPELINES/build_basin_hydrological_roles.py",
    "basins:waterbodies": "python PIPELINES/build_transboundary_water_bodies.py",
    "basins:waterbody-review": "python PIPELINES/cross_reference_water_bodies.py",
    "test:waterbody-review": "python -m pytest tests/test_water_body_cross_reference.py -q",
    "test:map-browser": "node TESTS/test_map_browser.cjs",
    "basins:dams": "python PIPELINES/build_basin_dams.py",
    "basins:wastewater": "python PIPELINES/build_basin_wastewater.py",
    "rivers:condition": "python PIPELINES/build_reach_condition.py",
    "stations:pskem": "python PIPELINES/build_pskem_observations.py",
    "cases:build": "python PIPELINES/build_chirchik_case_studies.py",
    "cases:forcing": "python PIPELINES/extract_case_study_forcing.py",
    "cases:figures": "python PIPELINES/plot_chirchik_case_studies.py",
    "cases:sabitov:inputs": "python PIPELINES/extract_sabitov_inputs.py",
    "cases:sabitov": "python PIPELINES/analyse_sabitov_methods.py && python PIPELINES/report_sabitov_methods.py",
    "cases:update:offline": "python PIPELINES/update_chirchik_studies.py --offline",
    "test:sabitov": "python -m pytest tests/test_sabitov_methods.py -q",
    "test:cases": "python -m pytest tests/test_chirchik_case_studies.py tests/test_chirchik_advanced.py -q",
    "basins:domain": "python PIPELINES/build_aral_hydrographic_domain.py",
    "basins:network": "python PIPELINES/build_basin_network_web.py",
    "basins:reference": "python PIPELINES/build_reference_basins.py",
    "rivers:reference": "python PIPELINES/build_reference_rivers.py",
    "basins:catalogue": "python PIPELINES/build_reference_attribute_catalogue.py",
    "casestudy:highlights": "python PIPELINES/build_case_study_highlights.py",
    "casestudy:dailymodel": "python PIPELINES/build_pskem_daily_model.py",
    "casestudy:figures": "python PIPELINES/build_pskem_model_figures.py",
    "rivers:unified": "python PIPELINES/build_unified_river_network.py",
    "headwaters:update": "npm run headwaters:era5 && npm run headwaters:era5:elevation && npm run headwaters:anomaly && npm run headwaters:snow && npm run climate:web",
    "hydroclimate:update": "npm run rivers:unified && npm run basins:era5 && npm run basins:anomaly && npm run headwaters:era5:elevation && npm run headwaters:snow && npm run climate:web",
    "catalogue:build": "python PIPELINES/build_data_catalogue.py",
    "data:groups": "python PIPELINES/build_data_groups.py",
    "data:items": "python PIPELINES/build_data_items.py",
    "review:build": "python PIPELINES/build_review_layers.py",
    "landcover:cog": "python PIPELINES/analyse_landcover_district.py",
    "landcover:gee": "python PIPELINES/analyse_landcover_gee.py",
    "landcover:stats": "python PIPELINES/build_landcover_statistics.py",
    "landcover:web": "python PIPELINES/build_landcover_web.py",
    "climate:web": "python PIPELINES/build_basin_layers_web.py",
    "cfsv2:observe": "python PIPELINES/cfsv2_basin_service.py observe",
    "cfsv2:climatology": "python PIPELINES/cfsv2_basin_service.py climatology",
    "cfsv2:anomaly": "python PIPELINES/cfsv2_basin_service.py anomaly",
    "chirps:observe": "python PIPELINES/chirps_basin_service.py",
    "chirts:observe": "python PIPELINES/chirts_basin_service.py",
    "cpc:observe": "python PIPELINES/cpc_basin_service.py",
    "ghm:observe": "python PIPELINES/ghm_unit_service.py",
    "cams:state": "python PIPELINES/cams_basin_service.py state",
    "cams:skill": "python PIPELINES/cams_basin_service.py skill",
    "cams:events": "python PIPELINES/cams_event_verification.py",
    "data:currency": "python PIPELINES/build_data_currency.py",
    "ontology:structure": "python PIPELINES/build_ontology_structure.py",
    "ontology:audit": "python PIPELINES/audit_ontology_tables.py",
    "cases:analyse": "python PIPELINES/analyse_chirchik_validation.py",
    "cases:profiles": "python PIPELINES/extract_chirchik_environment.py --task profiles",
    "cases:energy": "python PIPELINES/extract_chirchik_environment.py --task energy --end 2026",
    "cases:models": "python PIPELINES/model_chirchik_water.py",
    "cases:figures:validation": "python PIPELINES/report_chirchik_environment.py",
    "cases:update": "python PIPELINES/update_chirchik_studies.py"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "1.35.0",
    "multer": "2.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
