    {
      "id": "hydrosheds-uz-2026",
      "label": "HydroSHEDS global hydrography and its Uzbekistan extractions",
      "inventory": "earth-engine-hydro",
      "agent": "uz:agent/hydrosheds",
      "license": "hydrosheds-license-agreement",
      "attribution": "HydroSHEDS (Lehner & Grill), WWF and partners",
      "accessPolicy": "internal",
      "qualityFlags": ["licence-terms-to-confirm-before-redistribution"],
      "note": "Global reference hydrography, plus the two national subsets extracted from it. Both extractions select every basin with a positive-area intersection with Uzbekistan and keep whole polygons, so basin statistics computed from them describe the basin, not the part inside the border.",
      "datasets": [
        {"slug": "hydrosheds-basinatlas-global", "label": "BasinATLAS v1.0 (global source)",
         "match": ["BasinATLAS_Data_v10.gdb/BasinATLAS_v10.gdb"],
         "theme": "uz:theme/water", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/drainage-basin"],
         "useCases": ["uz:usecase/water-resource-allocation"],
         "note": "Twelve nested levels of HydroBASINS polygons carrying 296 hydro-environmental attributes each. Referenced in place at 6.0 GB."},
        {"slug": "hydrosheds-hydrolakes-global", "label": "HydroLAKES v1.0 (global source)",
         "match": ["HydroLAKES_polys_v10.gdb/HydroLAKES_polys_v10.gdb"],
         "theme": "uz:theme/water", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/surface-water-extent", "uz:prop/reservoir-volume"],
         "useCases": ["uz:usecase/water-resource-allocation"]},
        {"slug": "hydrosheds-hydrorivers-asia", "label": "HydroRIVERS v1.0 (Asia source)",
         "match": ["HydroRIVERS_v10_as.gdb/HydroRIVERS_v10_as.gdb"],
         "theme": "uz:theme/water", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/river-network", "uz:prop/surface-runoff"],
         "useCases": ["uz:usecase/water-resource-allocation"]},
        {"slug": "hydrobasins-uz-lake-v1c", "label": "Uzbekistan HydroBASINS extraction (lake format)",
         "match": ["uzbekistan_hydrobasins_lake_v1c/"],
         "theme": "uz:theme/water", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/drainage-basin", "uz:prop/surface-water-extent"],
         "useCases": ["uz:usecase/water-resource-allocation", "uz:usecase/irrigation-planning"],
         "places": ["uz:place/uzbekistan"],
         "note": "15,195 basins across levels 01-12 in lake format, which splits basins at lakes. Ships PFAF hierarchy, cross-level feature links and native downstream routing as tables. The boundary was recovered from the uzb_admbnda_adm0_2018b ArcGIS Feature Service after the local copy failed to read."},
        {"slug": "basinatlas-uz-v10", "label": "Uzbekistan BasinATLAS extraction",
         "match": ["uzbekistan_basinatlas_v10/"],
         "theme": "uz:theme/water", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/drainage-basin", "uz:prop/surface-runoff"],
         "useCases": ["uz:usecase/water-resource-allocation", "uz:usecase/irrigation-planning",
                      "uz:usecase/drought-early-warning"],
         "places": ["uz:place/uzbekistan"],
         "note": "14,749 basins across levels 01-12, each carrying the full 296 BasinATLAS attributes. Extracted from the global source with scripts/extract_uz_basinatlas.py under the same rules as the lake package, and validated: identifiers unique per level, every child basin resolving to a selected parent, no routing target missing from the source, and overlap sums matching the national area at every level."}
      ]
    },
