    {
      "id": "uzhydromet-stations-2022",
      "label": "Uzhydromet station network and climate series",
      "inventory": "maps-drop-2026-08",
      "agent": "uz:agent/uzhydromet",
      "license": "restricted-internal",
      "attribution": "Uzhydromet, delivery of 2022-05-26",
      "accessPolicy": "internal",
      "datasets": [
        {"slug": "meteorological-station-network", "label": "Meteorological station network",
         "match": ["Meteostan sheip original/МетеоСтанции.shp"],
         "theme": "uz:theme/climate", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/monitoring-station"],
         "stations": {"network": "uzhydromet-meteo", "encoding": "cp1251", "keyField": "NomerS",
                      "nameField": "NameSt", "xField": "POINT_X", "yField": "POINT_Y",
                      "classField": "nameCat"},
         "qualityFlags": ["attribute-encoding-cp1251", "station-key-not-wmo-index"],
         "note": "86 stations. The .dbf carries no encoding declaration and must be read as cp1251 or the names arrive as mojibake. Station numbers are six-digit operator codes, not the five-digit WMO indices used by the climate workbooks, so the two cannot be joined until a crosswalk is supplied."},
        {"slug": "station-air-temperature-series", "label": "Station air-temperature series",
         "match": ["Excel files/Andijan+Namangan+Fergana.xlsx", "Excel files/Bukhara+Samarkand.xlsx",
                   "Excel files/Jizzak+Syrdarya.xlsx", "Excel files/Karakalpakstan.xlsx",
                   "Excel files/Kashkadarya+Surkhandarya.xlsx", "Excel files/Khorezm+Navoi.xlsx",
                   "Excel files/Tashkent.xlsx"],
         "theme": "uz:theme/climate", "analysis": "uz:analysis/change-over-time",
         "observes": ["uz:prop/air-temperature", "uz:prop/monitoring-station"],
         "useCases": ["uz:usecase/drought-early-warning"],
         "note": "One sheet per station, named '<WMO index> <station>', each a Years x months matrix running October to September. Roughly 70 stations across seven workbooks: the ground truth the atlas temperature trend rasters were interpolated from."},
        {"slug": "station-soil-temperature-series", "label": "Station soil-temperature series",
         "match": ["Excel files/Температура почвы.xlsx"],
         "theme": "uz:theme/climate", "analysis": "uz:analysis/change-over-time",
         "observes": ["uz:prop/soil-temperature", "uz:prop/monitoring-station"]},
        {"slug": "kamchik-pass-climate-series", "label": "Kamchik pass temperature and precipitation",
         "match": ["Excel files/Камчик_температура_воздуха_и_осадки.xlsx"],
         "theme": "uz:theme/climate", "analysis": "uz:analysis/change-over-time",
         "observes": ["uz:prop/air-temperature", "uz:prop/precipitation"]},
        {"slug": "river-gauge-inventory", "label": "River gauge inventory",
         "match": ["Excel files/gages_data_rus.xlsx", "Excel files/Water discharges.xlsx"],
         "theme": "uz:theme/water", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/river-discharge", "uz:prop/monitoring-station"],
         "useCases": ["uz:usecase/water-resource-allocation", "uz:usecase/disaster-risk-reduction"],
         "stations": {"network": "uzhydromet-gauge", "sheet": "Лист1", "keyField": "INDEX",
                      "nameField": "RIVERS", "xField": "X", "yField": "Y", "classField": "LOCATION",
                      "labelIncludesClass": true},
         "note": "Gauge list with coordinates, so the discharge series can be mapped. This is the missing link between the hydrological tables and the river network."}
      ]
    },
