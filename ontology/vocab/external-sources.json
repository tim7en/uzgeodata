{
  "version": "1.0",
  "description": "How files in a profiled external delivery map onto datasets. This is curator knowledge, not inference: a human decides that these files are one dataset and that it observes these properties. The build measures everything else (feature counts, CRS, extent, fields) from the files themselves. To take in a new delivery, profile it and add a block here.",
  "matching": "A 'match' entry ending in / is a path prefix; otherwise it is an exact path, relative to the delivery root.",
  "sources": [
    {
      "id": "osm-geofabrik-2014",
      "label": "OpenStreetMap extract for Uzbekistan",
      "inventory": "maps-drop-2026-08",
      "agent": "uz:agent/openstreetmap",
      "license": "ODbL-1.0",
      "attribution": "© OpenStreetMap contributors, extract via Geofabrik / mapcruzin.com",
      "accessPolicy": "free",
      "temporal": {"start": 2014, "end": 2014},
      "note": "Already converted to GeoJSON in storage/derived/osm-geojson; catalogued here so the licence, the 2014 vintage and the provenance travel with the derivatives.",
      "datasets": [
        {"slug": "osm-buildings", "label": "OSM building footprints", "match": ["buildings/buildings.shp"],
         "derived": ["storage/derived/osm-geojson/buildings.geojson"],
         "theme": "uz:theme/infrastructure", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/building-footprint", "uz:prop/settlement-extent"],
         "useCases": ["uz:usecase/urban-and-settlement-planning"]},
        {"slug": "osm-landuse", "label": "OSM land use", "match": ["landuse/landuse.shp"],
         "derived": ["storage/derived/osm-geojson/landuse.geojson"],
         "theme": "uz:theme/land-agriculture", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/land-use-type"],
         "useCases": ["uz:usecase/urban-and-settlement-planning"]},
        {"slug": "osm-natural", "label": "OSM natural features", "match": ["natural/natural.shp"],
         "derived": ["storage/derived/osm-geojson/natural.geojson"],
         "theme": "uz:theme/land-agriculture", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/land-cover"]},
        {"slug": "osm-places", "label": "OSM populated places", "match": ["places/places.shp"],
         "derived": ["storage/derived/osm-geojson/places.geojson"],
         "theme": "uz:theme/infrastructure", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/settlement-extent"],
         "useCases": ["uz:usecase/urban-and-settlement-planning"]},
        {"slug": "osm-points", "label": "OSM points of interest", "match": ["points/points.shp"],
         "derived": ["storage/derived/osm-geojson/points.geojson"],
         "theme": "uz:theme/infrastructure", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/point-of-interest"]},
        {"slug": "osm-railways", "label": "OSM railways", "match": ["railways/railways.shp"],
         "derived": ["storage/derived/osm-geojson/railways.geojson"],
         "theme": "uz:theme/infrastructure", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/railway-network"]},
        {"slug": "osm-waterways", "label": "OSM waterways", "match": ["waterways/waterways.shp"],
         "derived": ["storage/derived/osm-geojson/waterways.geojson", "storage/derived/osm-geojson/water-bodies.geojson"],
         "theme": "uz:theme/water", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/surface-water-extent", "uz:prop/irrigation-canal-network"],
         "useCases": ["uz:usecase/water-resource-allocation"]}
      ]
    },
    {
