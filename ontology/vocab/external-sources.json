         "theme": "uz:theme/land-agriculture", "analysis": "uz:analysis/resource-system",
         "observes": ["uz:prop/land-tenure"]},
        {"slug": "cadastre-water", "label": "Cadastre: water objects",
         "match": ["Shape_files/Water_production_ready.geojson"],
         "theme": "uz:theme/water", "analysis": "uz:analysis/environmental-feature",
         "observes": ["uz:prop/surface-water-extent"],
         "useCases": ["uz:usecase/water-resource-allocation"]},
        {"slug": "tashkent-city-boundary", "label": "Tashkent city boundary",
         "match": ["Shape_files/Tashkent_borders.geojson"],
         "theme": "uz:theme/infrastructure", "analysis": "uz:analysis/environmental-feature",
