{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uzgeodata.uz/schema/predicate.json",
  "title": "Predicate registry",
  "description": "Typed relations. Every assertion must use a registered predicate; the validator enforces domain, range and cardinality, which is what makes machine-generated assertions checkable.",
  "type": "object",
  "required": ["version", "predicates"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+$"},
    "predicates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "domain", "range", "cardinality", "definition"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^uz:[a-zA-Z]+$"},
          "label": {"type": "string"},
          "definition": {"type": "string", "minLength": 10},
          "domain": {
            "type": "array", "minItems": 1,
            "items": {"enum": ["Dataset", "Distribution", "MapLayer", "MonitoringStation", "Concept", "Agent", "Basin", "RiverReach", "WaterBody"]}
          },
          "range": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["entity", "concept", "literal"]},
              "entityTypes": {"type": "array", "items": {"enum": ["Dataset", "Distribution", "MapLayer", "MonitoringStation", "Agent", "Basin", "RiverReach", "WaterBody"]}},
              "schemes": {"type": "array", "items": {"type": "string"}},
              "literalType": {"enum": ["string", "number", "integer", "boolean", "interval", "bbox"]}
            }
          },
          "cardinality": {"enum": ["one", "many"]},
          "mlProposable": {
            "type": "boolean", "default": false,
            "description": "Whether a model is allowed to generate candidate assertions for this predicate. Structural facts are rule-derived only."
          },
          "viaRelationshipTable": {
            "type": "boolean", "default": false,
            "description": "This predicate is asserted in bulk by a relationship-table Distribution rather than one assertion per fact. Measured feature topology is declared this way: the table is the system of record and the graph records its meaning, its size and where to read it. Such a predicate must never be mlProposable, because a model cannot measure topology."
          },
          "inverseOf": {"type": "string"}
        }
      }
    }
  }
}
