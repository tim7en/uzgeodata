  "analysisRules": [
    {
      "id": "hazard-first",
      "priority": 40,
      "concept": "uz:analysis/risk-exposure",
      "weight": 0.85,
      "terms": ["risk", "hazard", "earthquake", "flood", "mudflow", "drought", "adverse", "fatalit", "losses", "exposure", "риск", "опасн", "землетрясен", "наводнен", "сель", "засух", "ущерб", "погибш"],
      "note": "Evaluated before the year rule so a decades-long hazard catalogue is not misfiled as a change series."
    },
    {
      "id": "change-series",
      "priority": 30,
      "concept": "uz:analysis/change-over-time",
      "weight": 0.8,
      "terms": ["dynamics", "trend", "change", "динамик", "тренд", "изменен"],
      "requiresIntervalOrTerm": true,
      "note": "Also triggered when temporalCoverage spans more than one year."
    },
    {
      "id": "resource-system",
      "priority": 20,
      "concept": "uz:analysis/resource-system",
      "weight": 0.75,
      "terms": ["management", "irrigat", "drainage", "canal", "access", "supply", "sanitation", "stocking", "yield", "livestock", "farming system", "use intensity", "served by", "управлен", "орошен", "дренаж", "канал", "водоснабжен", "санитар"]
    },
    {
      "id": "observation-index",
      "priority": 10,
      "concept": "uz:analysis/state-observation",
      "weight": 0.7,
      "terms": ["index", "ndvi", "evi", "productivity", "richness", "intactness", "integrity", "score", "volume", "depth", "density", "balance", "sequestration", "индекс", "продуктивн", "запас", "объём", "объем", "глубин", "плотност"]
    },
    {
      "id": "feature-default",
      "priority": 0,
      "concept": "uz:analysis/environmental-feature",
      "weight": 0.5,
      "default": true
    }
  ],
