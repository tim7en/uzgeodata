{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uzgeodata.uz/schema/concept-scheme.json",
  "title": "Concept scheme",
  "description": "A controlled vocabulary. Concepts are identified by stable IDs and are never referenced by display label.",
  "type": "object",
  "required": ["scheme", "version", "concepts"],
  "additionalProperties": false,
  "properties": {
    "scheme": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "reference": {
      "type": "string",
      "description": "Citation for the scheme as a whole, where it is derived from published work."
    },
    "version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+$"},
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prefLabel", "definition"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^uz:[a-z-]+/[a-z0-9-]+$"},
          "prefLabel": {"type": "string", "minLength": 2},
          "altLabels": {"type": "array", "items": {"type": "string"}},
          "definition": {"type": "string", "minLength": 10},
          "broader": {"type": "string", "pattern": "^uz:[a-z-]+/[a-z0-9-]+$"},
          "related": {"type": "array", "items": {"type": "string"}},
          "unit": {"type": "string", "description": "Canonical unit of the observed property, where one applies."},
          "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
          "note": {"type": "string"},
          "deprecated": {"type": "boolean", "default": false},
          "replacedBy": {"type": "string"}
        }
      }
    }
  }
}
