{
  "version": 1,
  "groups": [
    {
      "id": "regional-terraclimate",
      "label": "TerraClimate water balance",
      "kind": "regional",
      "source": "terraclimate",
      "interval_days": 30,
      "requires": [
        "PUBLISHED/data/atlas/cube/index.json",
        "PUBLISHED/data/atlas/history/index.json",
        "GEODATA/transboundary_basins_v2/hydroatlas-level12-full-basins.geojson"
      ],
      "full_requires": [
        "GEODATA/BasinATLAS_Data_v10.gdb/BasinATLAS_Data_v10.gdb/BasinATLAS_v10.gdb",
        "PUBLISHED/data/atlas/observations/time_kind=observation"
      ],
      "modules": [
        "duckdb",
        "pyarrow",
        "pyogrio",
        "ee"
      ],
      "earth_engine": true,
      "note": "Fetches months newer than the published record from Earth Engine. With the full observation store and BasinATLAS geodatabase present it runs the complete refresh; without them it appends to the published history and cube only, leaving climatologies and the release as last published."
    },
