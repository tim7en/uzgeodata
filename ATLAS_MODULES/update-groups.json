    {
      "id": "hydroclimate",
      "label": "Regional hydroclimate",
      "kind": "commands",
      "commands": [
        [
          "PIPELINES/update_headwater_era5.py",
          "--scope",
          "full-basin"
        ],
        [
          "PIPELINES/era5_headwater_anomaly_service.py",
          "--scope",
          "full-basin"
        ],
        [
          "PIPELINES/update_headwater_era5.py"
        ],
        [
          "PIPELINES/era5_headwater_anomaly_service.py"
        ],
        [
          "PIPELINES/update_headwater_era5_elevation.py"
        ],
        [
          "PIPELINES/modis_snow_headwater_service.py"
        ],
        [
          "PIPELINES/build_basin_layers_web.py"
        ]
      ],
      "interval_days": 30,
      "requires": [],
      "modules": [
        "ee",
        "geopandas",
        "rasterio"
      ],
      "earth_engine": true,
      "note": "Runs the existing dependency-ordered pipeline. Source credentials and local inputs must be available."
    },
    {
      "id": "landcover",
