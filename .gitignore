node_modules/
# Wrangler's local state: simulated R2/KV for `wrangler dev`, build temp files.
.wrangler/
.venv/
dist/
.env
.env.*
# The placeholder template is the one env file worth sharing: it documents the
# variables (admin login, R2 publication tokens) without carrying any value.
!.env.example
*.local
*.log
WORKSPACE/
GEODATA/atlas_sources/
GEODATA/ca-discharge-2023/
tmp/

# Source geodatabases: multi-gigabyte binary directories that are reference data,
# not project source. Catalogue them through the ontology (they are referenced in
# place via uz:externalLocation) rather than committing them.
# BasinATLAS_Data_v10.gdb is 4.3 GB unpacked, 2.6 GB zipped, and ships a second
# copy nested under GEODATA/.
GEODATA/BasinATLAS_Data_v10.gdb/
GEODATA/BasinATLAS_Data_v10.gdb.zip
*.gdb/
*.gdb.zip

# Delivery archives. GitHub rejects any file over 100 MB, and an archive of data
# the repo already holds unpacked is duplication either way.
*.rar
*.7z
GEODATA.zip
earth_engine.zip

# Bulk observation partitions. As Parquet the whole store is 442 MB and a partition
# is about 20 MB, so the original reason for this line - a year partition passing
# GitHub's 100 MB file limit - no longer holds. It stays excluded for a different
# reason: Parquet is binary and does not delta-compress, so every re-extraction would
# add another full copy to a history that is already 1.5 GB, permanently and with no
# way to expire it. Git versions source; it is not an archive for derived data.
#
# That leaves the store on one disk, which is a real risk and not one this file can
# fix: publish it as a release asset or to Zenodo, where it can be versioned and
# cited rather than merely present. Nothing in INTERFACE/ fetches it and the launch
# build excludes any time_kind= path, so the site neither needs nor ships it.
#
# The small files beside it - the run ledgers, manifests and the
# run/recipe/source_release/basin_geometry tables - stay tracked: those are the
# provenance record, and they are what makes the bulk regenerable.
PUBLISHED/data/atlas/observations/time_kind=*/

# Station-point product extractions. Derived: both are regenerated from Earth Engine
# in about 75 seconds by PIPELINES/extract_station_products.py, and together they are
# 92 MB that would otherwise sit in history forever.
PUBLISHED/data/hydromet/station-product-series.csv
PUBLISHED/data/hydromet/nsidc-product-series.csv
PUBLISHED/data/hydromet/station-product-pairs.csv

# Derived counting cache for the observation store: machine-specific mtimes, and
# rebuilt for free whenever it is missing.
PUBLISHED/data/atlas/observations/.summary-cache.json

# Python bytecode
__pycache__/
*.pyc
.pytest_cache/

# Reference hydrography downloaded from HydroSHEDS and Global Dam Watch. These
# are source data, not project source: catalogue them through the ontology,
# which references them in place via uz:externalLocation. The *.gdb/ rule above
# already covers the geodatabases; GloRiC ships as a 1.2 GB shapefile and the
# delivery archives are another 1.7 GB, and GitHub rejects any file over 100 MB.
earth_engine/earth_engine/GloRiC_v10/
earth_engine/earth_engine/FFR_v1/
earth_engine/earth_engine/GDW_v1_0/
earth_engine/earth_engine/HydroWASTE_v10/
earth_engine/_source_archives/

# Fitted model binaries. Pickles are reproducible from the training pipelines
# (npm run discharge:*) and grow with every rerun; commit the JSON/CSV results
# and the recipes, not the artefacts.
PUBLISHED/data/case-studies/*.pkl

# Bulky model-intermediate tables. The distilled results (importance, skill,
# error analysis, predictions, manifests) are tracked; these inputs are
# regenerated by npm run discharge:features and npm run cases:water-flow.
PUBLISHED/data/case-studies/basin_climate.csv
PUBLISHED/data/case-studies/antecedent_discharge_features.csv
PUBLISHED/data/case-studies/enhanced_discharge_features.csv
PUBLISHED/data/case-studies/antecedent_discharge_features_aral.csv
PUBLISHED/data/case-studies/enhanced_discharge_features_aral.csv
PUBLISHED/data/case-studies/regional_discharge_data.csv

# Raw per-pass SWOT observations for all 378 lakes -- consumed by
# build_swot_lake_crosswalk.py to build the small per-lake JSONs the map
# actually serves; not needed standalone and regenerated by npm run
# reservoirs:fetch.
PUBLISHED/data/case-studies/reservoirs/reservoir_observations_raw.csv

# Raw per-pass SWOT observations for all named river reaches -- consumed by
# build_swot_river_products.py to build the per-reach JSONs and the trimmed
# map-layer GeoJSON the map actually serves; regenerated by npm run
# rivers:fetch.
PUBLISHED/data/case-studies/rivers/river_observations_raw.csv

# Full-density SWORD reach geometry (avg 324 vertices/reach, 6.3 MB) fetched
# by fetch_swot_rivers.py. build_swot_river_products.py simplifies it to the
# ~20 vertices/reach a national-scale web map actually needs and publishes
# that as reaches.geojson; the full-density copy is not itself served.
PUBLISHED/data/case-studies/rivers/reaches_prior.geojson
PUBLISHED/data/case-studies/**/*.pkl
.DS_Store

# QC summary CSVs written by the ANALYSIS_R/ per-dataset scripts. Regenerated
# on every run (Rscript ANALYSIS_R/run_all.R) from the tracked PUBLISHED/data
# files; committing them would just be a stale snapshot next to the source.
ANALYSIS_R/output/

# Regenerated climate continuation packages (npm run climate:regional:update and
# cases:pskem-climate). The regional package is ~440 MB of Parquet and per-basin
# JSON; both ship to R2 through PUBLISHED/release-includes.txt, not through git.
PUBLISHED/data/atlas/climate-continuation/
PUBLISHED/data/case-studies/pskem-climate-continuation/
