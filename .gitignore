node_modules/
dist/
.env
.env.*
*.local
*.log
WORKSPACE/
GEODATA/atlas_sources/
tmp/

# Source geodatabases: multi-gigabyte binary directories that are reference data,
# not project source. Catalogue them through the ontology (they are referenced in
# place via uz:externalLocation) rather than committing them.
# BasinATLAS_Data_v10.gdb is 4.3 GB unpacked, 2.6 GB zipped, and ships a second
# copy nested under GEODATA/.
GEODATA/BasinATLAS_Data_v10.gdb/
GEODATA/BasinATLAS_Data_v10.gdb.zip
*.gdb/
*.gdb.zip

# Delivery archives. GitHub rejects any file over 100 MB, and an archive of data
# the repo already holds unpacked is duplication either way.
*.rar
*.7z
GEODATA.zip
earth_engine.zip

# Python bytecode
__pycache__/
*.pyc
.pytest_cache/

# Reference hydrography downloaded from HydroSHEDS and Global Dam Watch. These
# are source data, not project source: catalogue them through the ontology,
# which references them in place via uz:externalLocation. The *.gdb/ rule above
# already covers the geodatabases; GloRiC ships as a 1.2 GB shapefile and the
# delivery archives are another 1.7 GB, and GitHub rejects any file over 100 MB.
earth_engine/earth_engine/GloRiC_v10/
earth_engine/earth_engine/FFR_v1/
earth_engine/earth_engine/GDW_v1_0/
earth_engine/earth_engine/HydroWASTE_v10/
earth_engine/_source_archives/
