ADMIN_USERNAME=change-me
ADMIN_PASSWORD=use-a-long-unique-password
PORT=5173
# Set to true only when the deployed site is served over HTTPS.
COOKIE_SECURE=false

# Cloudflare R2 publication (npm run publish:r2). These are R2 S3-API tokens, not
# the wrangler OAuth login: create them in the dashboard under
# R2 -> API -> Manage API tokens, with Object Read & Write on uzgeodata-public.
# Never commit the filled-in .env; only this example is tracked.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=r2-access-key-id
R2_SECRET_ACCESS_KEY=r2-secret-access-key
# Optional: defaults to the bucket bound in wrangler.jsonc.
R2_BUCKET=uzgeodata-public
